<mujoco model="knee_joint">

    <compiler angle="degree" autolimits="true"/>
    <option timestep="0.001" gravity="0 0 -9.81"/>

    <worldbody>

        <!-- Fixed Base -->
        <body name="base" pos="0 0 0">

            <geom type="box"
                  size="0.05 0.03 0.02"
                  rgba="0.6 0.6 0.6 1"/>

            <!-- Upper Link -->
            <body name="link1" pos="0 0 0">

                <joint name="joint1"
                       type="hinge"
                       axis="0 1 0"/>

                <geom type="capsule"
                      fromto="0 0 0 0 0 -0.12"
                      size="0.02"/>

                <!-- Shaft -->
                <body name="shaft" pos="0 0 -0.12">

                    <joint name="joint2"
                           type="hinge"
                           axis="0 1 0"/>

                    <geom type="cylinder"
                          size="0.015 0.04"
                          rgba="0.7 0.7 0.7 1"/>

                    <!-- Slider -->
                    <body name="coupler" pos="0 0 0">

                        <joint name="joint3"
                               type="slide"
                               axis="0 0 1"
                               range="-0.02 0.02"/>

                        <geom type="box"
                              size="0.03 0.02 0.02"
                              rgba="0.9 0.9 0.9 1"/>

                        <!-- Connecting rod -->
                        <body name="rod" pos="0 0 -0.02">

                            <joint name="joint4"
                                   type="hinge"
                                   axis="0 1 0"/>

                            <geom type="capsule"
                                  fromto="0 0 0 0 0 -0.12"
                                  size="0.01"/>

                            <!-- Knee crank -->
                            <body name="crank" pos="0 0 -0.12">

                                <joint name="joint5"
                                       type="hinge"
                                       axis="0 1 0"/>

                                <geom type="capsule"
                                      fromto="0 0 0 0 0 -0.06"
                                      size="0.02"
                                      rgba="0.8 0.8 0.8 1"/>

                                <!-- Lower leg -->
                                <body name="shank" pos="0 0 -0.06">

                                    <joint name="joint6"
                                           type="hinge"
                                           axis="0 1 0"/>

                                    <geom type="capsule"
                                          fromto="0 0 0 0 0 -0.10"
                                          size="0.02"/>

                                </body>

                            </body>

                        </body>

                    </body>

                </body>

            </body>

        </body>

    </worldbody>

    <actuator>

        <motor joint="joint5"
               gear="30"
               ctrlrange="-1 1"/>

    </actuator>

</mujoco>